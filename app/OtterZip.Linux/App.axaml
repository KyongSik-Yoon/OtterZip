<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OtterZip.Linux.App"
             RequestedThemeVariant="Default">

  <!-- RequestedThemeVariant="Default" means "follow the desktop", which is
       the Settings_Theme=system case. App.axaml.cs overrides it to Light or
       Dark when the user has pinned one. -->

  <Application.Resources>
    <ResourceDictionary>
      <!-- Inter ships with the app (Avalonia.Fonts.Inter) so the UI looks the
           same on a minimal container as on a full desktop, where fontconfig
           would otherwise substitute something arbitrary. -->
      <FontFamily x:Key="OtterZipFont">avares://Avalonia.Fonts.Inter/Assets#Inter, $Default</FontFamily>

      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF" />
          <SolidColorBrush x:Key="CardBorder" Color="#E1E1E1" />
          <SolidColorBrush x:Key="DropZoneActiveBackground" Color="#140078D4" />
          <SolidColorBrush x:Key="ErrorForeground" Color="#C42B1C" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="CardBackground" Color="#2C2C2C" />
          <SolidColorBrush x:Key="CardBorder" Color="#3D3D3D" />
          <SolidColorBrush x:Key="DropZoneActiveBackground" Color="#280078D4" />
          <SolidColorBrush x:Key="ErrorForeground" Color="#FF99A4" />
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <!-- Shared visual vocabulary. Kept here rather than in a separate
         resource dictionary because the Linux front end is one window plus
         two dialogs — a full theme split would be more files than styles. -->
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="{StaticResource OtterZipFont}" />
    </Style>

    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Opacity" Value="0.65" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource CardBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="12" />
    </Style>

    <!-- The drop target. The `.active` class is toggled from code-behind on
         DragOver/DragLeave so the whole panel reacts, not just the border. -->
    <Style Selector="Border.dropzone">
      <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.dropzone.active">
      <Setter Property="BorderBrush" Value="{DynamicResource SystemAccentColor}" />
      <Setter Property="Background" Value="{DynamicResource DropZoneActiveBackground}" />
    </Style>

    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="{DynamicResource ErrorForeground}" />
    </Style>
  </Application.Styles>


</Application>
