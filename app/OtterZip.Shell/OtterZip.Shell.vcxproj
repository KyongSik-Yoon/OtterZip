<!--
  Sprint 4 scaffold. Sets up the project layout so a developer with the
  C++/WinRT workload installed can build immediately. CI does not yet
  build this project — see ci-rust.yml / ci-dotnet.yml for current scope;
  Sprint 5 adds an MSVC-aware Shell job.
-->
<Project DefaultTargets="Build" ToolsVersion="17.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <CppWinRTOptimized>true</CppWinRTOptimized>
    <CppWinRTRootNamespaceAutoMerge>true</CppWinRTRootNamespaceAutoMerge>
    <CppWinRTGenerateWindowsMetadata>false</CppWinRTGenerateWindowsMetadata>
    <MinimumVisualStudioVersion>17.0</MinimumVisualStudioVersion>
    <ProjectGuid>{8B7E9F00-2222-3333-4444-555555555555}</ProjectGuid>
    <ProjectName>OtterZip.Shell</ProjectName>
    <RootNamespace>OtterZip::Shell</RootNamespace>
    <TargetPlatformVersion>10.0.22621.0</TargetPlatformVersion>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <DefaultLanguage>en-US</DefaultLanguage>
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'=='Release'">false</UseDebugLibraries>
    <WholeProgramOptimization Condition="'$(Configuration)'=='Release'">true</WholeProgramOptimization>
  </PropertyGroup>

  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <PropertyGroup>
    <LinkIncremental Condition="'$(Configuration)'=='Debug'">true</LinkIncremental>
    <LinkIncremental Condition="'$(Configuration)'=='Release'">false</LinkIncremental>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <WarningLevel>Level4</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <PreprocessorDefinitions>WIN32;_WINDOWS;_USRDLL;OTTERZIP_SHELL_EXPORTS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <!-- /utf-8: tell MSVC the source files are UTF-8 (silences C4819 on
           our doc comments that contain Korean / em-dash characters).
           /await: enable C++/WinRT coroutine support.
           /Zc:__cplusplus: report the actual C++ standard via the macro. -->
      <AdditionalOptions>/utf-8 /await /Zc:__cplusplus %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <ModuleDefinitionFile>OtterZip.Shell.def</ModuleDefinitionFile>
      <!-- WindowsApp.lib: WinRT activation factories (RoGetActivationFactory,
           RoOriginateLanguageException). Required by ShellSettings.cpp's
           ApplicationData::LocalSettings call (PR-7E). -->
      <AdditionalDependencies>WindowsApp.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="src\dllmain.cpp" />
    <ClCompile Include="src\ExtractHereCommand.cpp" />
    <ClCompile Include="src\CompressCommand.cpp" />
    <ClCompile Include="src\OtterzipMenuCommand.cpp" />
    <ClCompile Include="src\SubmenuCommands.cpp" />
    <ClCompile Include="src\ShellInvoke.cpp" />
    <ClCompile Include="src\ShellSettings.cpp" />
    <ClCompile Include="src\QuickCompressCommands.cpp" />
    <ClInclude Include="src\ExtractHereCommand.h" />
    <ClInclude Include="src\CompressCommand.h" />
    <ClInclude Include="src\OtterzipMenuCommand.h" />
    <ClInclude Include="src\SubmenuCommands.h" />
    <ClInclude Include="src\ShellInvoke.h" />
    <ClInclude Include="src\ShellSettings.h" />
    <ClInclude Include="src\QuickCompressCommands.h" />
    <None Include="OtterZip.Shell.def" />
    <None Include="Package.Shell.appxmanifest.fragment.xml" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />

  <!--
    NuGet pkg restore (auto): Microsoft.Windows.CppWinRT, Microsoft.WindowsAppSDK.
    Add via VS NuGet UI; we don't bundle versions here so a developer can pick
    the toolchain matching their installed SDK.
  -->
</Project>
