<?xml version="1.0" encoding="utf-8"?>
<!--
  OtterZip 컨트롤 스타일
  참조: docs/02-design/design-system.md

  전략:
  - WinUI 3 Fluent 기본 컨트롤을 최대한 재사용
  - 필요한 부분만 Style로 override
  - 복잡한 UserControl은 별도 .xaml 파일
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================ -->
    <!--  Buttons                                                          -->
    <!-- ================================================================ -->

    <!--
      DefaultButton: 시스템 스타일 그대로 (주석만 둠)
      AccentButton: Fluent의 AccentButtonStyle 재사용 (암묵 키)

      커스텀 IconButton: 32x32 투명 배경, hover Subtle
    -->
    <!--
      IconButton: 32x32 투명 배경, hover 상태는 Button 기본 템플릿의
      PointerOver VisualState가 처리 (Fluent 기본 subtle overlay).
      Style.Triggers 는 WPF 전용이라 WinUI 3 에서 사용 불가 — hover/press
      비주얼 커스텀이 필요하면 Template override 로 이동.
    -->
    <Style x:Key="IconButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
    </Style>

    <Style x:Key="IconToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource SubtleFillColorTransparentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
    </Style>

    <!--
      대형 Primary CTA 버튼 — DropSummary 등에서 사용
      full-width, 높이 40
    -->
    <Style x:Key="CtaAccentButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource AccentButtonStyle}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- ================================================================ -->
    <!--  PathField (TextBox + Browse Button)                              -->
    <!-- ================================================================ -->

    <Style x:Key="PathTextBoxStyle" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <!-- ================================================================ -->
    <!--  Archive format badge (작은 컬러 라벨)                            -->
    <!-- ================================================================ -->

    <Style x:Key="FormatBadgeBorderStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="FormatBadgeTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <!-- ================================================================ -->
    <!--  Card container (옵션 바, DropSummary 등 공통)                   -->
    <!-- ================================================================ -->

    <Style x:Key="CardContainerStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource BorderThin}" />
        <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource SpacingM}" />
    </Style>

    <!-- Compact card variant — for the main ConfigPanel where vertical
         density matters more than breathing room. Phase 6+ rev 5 polish:
         CornerRadius bumped 8→12 ("softer" feel), background uses the
         secondary card brush (slightly lighter) so cards float on the
         MicaAlt backdrop instead of vanishing into it. -->
    <Style x:Key="CompactCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource BorderThin}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="12,10" />
    </Style>

    <!-- Card header label — same size as Caption but with extra letter
         spacing + slight weight bump. Gives cards a clear "section"
         feel without ballooning the visual hierarchy. -->
    <Style x:Key="CardHeaderLabelStyle" TargetType="TextBlock"
           BasedOn="{StaticResource CaptionTextStyle}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="50" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <!-- ================================================================ -->
    <!--  Separator line                                                   -->
    <!-- ================================================================ -->

    <Style x:Key="RowSeparatorStyle" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
    </Style>

    <!-- ================================================================ -->
    <!--  Settings row layout                                              -->
    <!-- ================================================================ -->

    <Style x:Key="SettingsRowRootStyle" TargetType="Grid">
        <Setter Property="Padding" Value="0,12" />
    </Style>

    <Style x:Key="SettingsRowTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextStyle}" />
    <Style x:Key="SettingsRowDescStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SettingsSectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="CharacterSpacing" Value="100" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>

    <!-- ================================================================ -->
    <!--  Fluent settings card (A안 + B안 하이브리드)                      -->
    <!--  CompactCard Border + [아이콘 칩 | 제목·설명 | 컨트롤] 그리드.     -->
    <!--  브랜드 틴트 칩은 라이트/다크/고대비 3테마 모두 정의된 브러시 사용. -->
    <!-- ================================================================ -->

    <!-- 32x32 브랜드 틴트 아이콘 칩 (카드 선두 아이콘 배경) -->
    <Style x:Key="SettingsIconChipStyle" TargetType="Border">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{ThemeResource OtterzipBrandSoftBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- 칩 내부 FontIcon (브랜드 색) -->
    <Style x:Key="SettingsCardIconStyle" TargetType="FontIcon">
        <Setter Property="FontFamily" Value="{StaticResource SymbolThemeFontFamily}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{ThemeResource OtterzipBrandBrush}" />
    </Style>

    <!-- 카드 우측 토글 — On/Off 라벨 제거(카드 제목이 라벨), 폭 최소화.
         On 색은 시스템 액센트 유지(윈도우 네이티브 + 아이콘 액센트 철학). -->
    <Style x:Key="SettingsCardToggleStyle" TargetType="ToggleSwitch">
        <Setter Property="OnContent" Value="" />
        <Setter Property="OffContent" Value="" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <!-- 카드 제목 / 설명 (기존 Row 스타일 재사용 가능하나, 카드 컨텍스트
         전용 별칭으로 의미를 명확히 — 값은 동일 위계). -->
    <Style x:Key="SettingsCardTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="SettingsCardDescStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ================================================================ -->
    <!--  Browser list header cell                                         -->
    <!-- ================================================================ -->

    <Style x:Key="BrowserHeaderCellStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextStyle}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="50" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

    <Style x:Key="BrowserRowStyle" TargetType="Grid">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="12,8" />
    </Style>

</ResourceDictionary>
