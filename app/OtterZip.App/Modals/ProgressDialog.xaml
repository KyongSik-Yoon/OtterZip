<?xml version="1.0" encoding="utf-8"?>
<!--
  Bandizip-style standalone quick-compress progress modal.

  Design v2 (2026-05-18):
    * Mascot icon + filename header row
    * Status FontIcon glyph (✓ / ✗ / ⚠) that swaps on settle
    * Progress bar with smooth indeterminate→determinate transition
    * Status caption shows percent during work, summary (size + elapsed)
      on success
    * Action bar: [Open folder] + [Cancel/Close]
        — Cancel during work, Close after settle
        — Open folder visible only on Done state

  Sizing: 500×260 dev pixels — slightly larger than v1 (was 460×220) to
  fit the second button and status row comfortably.

  Brushes: all via {ThemeResource ...} per CLAUDE.md §0.5; no hardcoded
  hex. Strings: x:Uid for static button labels, programmatic GetString()
  for runtime-composed title/status text.
-->
<Window
    x:Class="OtterZip.App.Modals.ProgressDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <!-- Auto (not *) so the window can be resized to fit the content
                 exactly — no dead space below the compact progress view. -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="20,14,20,8" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header row: mascot avatar + archive name (over a secondary
                 line that shows the source summary, then the live current
                 file while a large entry streams) + status glyph. -->
            <Grid Grid.Row="0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0"
                       Width="40"
                       Height="40"
                       VerticalAlignment="Center"
                       Source="ms-appx:///Assets/Square150x150Logo.png" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                    <TextBlock x:Name="ArchiveNameText"
                               Style="{StaticResource BodyStrongTextBlockStyle}"
                               TextTrimming="CharacterEllipsis" />
                    <!-- Source summary / live current file. Set in code. -->
                    <TextBlock x:Name="CurrentFileText"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- Status glyph: hidden during work, shows ✓ on done /
                     ✗ on cancel / ⚠ on error after settle. Color via
                     Foreground binding from code-behind. -->
                <FontIcon Grid.Column="2"
                          x:Name="StatusGlyph"
                          FontFamily="Segoe Fluent Icons"
                          FontSize="22"
                          VerticalAlignment="Center"
                          Visibility="Collapsed" />
            </Grid>

            <!-- Progress bar. Indeterminate until first tick; switches
                 to determinate as soon as a percent is reported. -->
            <ProgressBar Grid.Row="1"
                         x:Name="OverallBar"
                         IsIndeterminate="True"
                         Maximum="100"
                         Height="8"
                         CornerRadius="4" />

            <!-- Status line. During work: percent text composed in
                 code-behind. On settle: full summary (size + elapsed)
                 written from the JobSettled handler. -->
            <TextBlock Grid.Row="2"
                       x:Name="StatusText"
                       x:Uid="ProgressDialog_StatusReady"
                       Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" />
        </Grid>

        <!-- Action bar. Two buttons; OpenFolder visible only on Done. -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Padding="0,0,20,16"
                    Spacing="8">
            <Button x:Name="OpenFolderButton"
                    x:Uid="ProgressDialog_OpenFolderButton"
                    Click="OnOpenFolderClick"
                    MinWidth="120"
                    Visibility="Collapsed" />
            <Button x:Name="ActionButton"
                    x:Uid="ProgressDialog_CancelButton"
                    Click="OnActionButtonClick"
                    Style="{StaticResource AccentButtonStyle}"
                    MinWidth="100" />
        </StackPanel>
    </Grid>
</Window>
