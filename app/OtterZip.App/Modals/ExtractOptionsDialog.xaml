<?xml version="1.0" encoding="utf-8"?>
<!--
  v0.22 dedicated extract-options dialog. Reached from the shell verb
  "OtterZip으로 풀기...(B)" (ExtractDialogCommand, verb "extract-dialog").
  Hosts the existing ExtractPanel UserControl (destination / password /
  buttons, already localized + wrong-password aware) and flips in-place
  to an embedded JobProgressView to run the extract — one window instead
  of the full MainWindow surface.

  All strings via x:Uid / the reused ExtractPanel; brushes via
  {ThemeResource} (CLAUDE.md §0.5).
-->
<Window
    x:Class="OtterZip.App.Modals.ExtractOptionsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:modals="using:OtterZip.App.Modals"
    xmlns:controls="using:OtterZip.App.UserControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

        <controls:ExtractPanel x:Name="Panel" />

        <!-- Top-aligned so its natural height drives the window fit (SizeChanged
             fires when the status line grows/shrinks → window re-fits). -->
        <modals:JobProgressView x:Name="Progress"
                                VerticalAlignment="Top"
                                Visibility="Collapsed" />
    </Grid>
</Window>
