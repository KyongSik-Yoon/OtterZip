<?xml version="1.0" encoding="utf-8"?>
<!--
  Shared job-progress surface for the v0.22 option dialogs
  (CompressOptionsDialog / ExtractOptionsDialog). Lifts the proven
  progress UI out of ProgressDialog into a reusable UserControl so the
  two new dialogs can transition from their option form into a live
  progress view inside the same window (Bandizip parity) without each
  re-implementing the mascot / bar / settle-glyph rendering.

  ProgressDialog itself is intentionally left untouched (it owns the
  single-archive quick-compress path that already shipped) — this
  control carries one copy of the logic for the new dialogs only.

  Brushes via {ThemeResource}; static button labels via x:Uid; runtime
  title/status composed in code-behind. (CLAUDE.md §0.5)
-->
<UserControl
    x:Class="OtterZip.App.Modals.JobProgressView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="24,24,24,16" RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0"
                       Width="48"
                       Height="48"
                       VerticalAlignment="Center"
                       Source="ms-appx:///Assets/Square150x150Logo.png" />

                <TextBlock Grid.Column="1"
                           x:Name="ArchiveNameText"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />

                <FontIcon Grid.Column="2"
                          x:Name="StatusGlyph"
                          FontFamily="Segoe Fluent Icons"
                          FontSize="28"
                          VerticalAlignment="Center"
                          Visibility="Collapsed" />
            </Grid>

            <ProgressBar Grid.Row="1"
                         x:Name="OverallBar"
                         IsIndeterminate="True"
                         Maximum="100"
                         Height="6" />

            <TextBlock Grid.Row="2"
                       x:Name="StatusText"
                       x:Uid="ProgressDialog_StatusReady"
                       Style="{StaticResource BodyTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextWrapping="Wrap" />
        </Grid>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Padding="0,0,24,20"
                    Spacing="8">
            <Button x:Name="OpenFolderButton"
                    x:Uid="ProgressDialog_OpenFolderButton"
                    Click="OnOpenFolderClick"
                    MinWidth="120"
                    Visibility="Collapsed" />
            <Button x:Name="ActionButton"
                    x:Uid="ProgressDialog_CancelButton"
                    Click="OnActionButtonClick"
                    Style="{StaticResource AccentButtonStyle}"
                    MinWidth="100" />
        </StackPanel>
    </Grid>
</UserControl>
