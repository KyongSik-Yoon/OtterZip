<?xml version="1.0" encoding="utf-8"?>
<!--
  FloatLayer — visual host for the JobQueue's floating job cards.

  Positioned by MainWindow at the bottom of the canvas, this control
  just renders one JobCard per JobItem in the queue's observable
  collection. Cards stack vertically and grow upward as new jobs arrive.

  No user-facing strings in the layout itself; everything pulls through
  JobCard from the bound JobItem. Brushes route via {ThemeResource} where
  applicable (the layer container is fully transparent so the canvas
  shines through).
-->
<UserControl
    x:Class="OtterZip.App.UserControls.FloatLayer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    IsHitTestVisible="True">

    <!-- ScrollViewer fills the available height (MainWindow caps the
         layer top margin so the chip strip is never covered). Inside,
         a Grid wrapper whose MinHeight mirrors the ScrollViewer's
         ViewportHeight (kept in sync from code-behind) lets the bottom-
         anchored ItemsControl sit at the bottom of the viewport when
         only a few cards exist — new cards push earlier cards upward.
         When the stack grows past the viewport, the wrapper expands and
         scrolling kicks in automatically. -->
    <ScrollViewer x:Name="Scroller"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollMode="Disabled"
                  VerticalScrollMode="Enabled"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  SizeChanged="OnScrollerSizeChanged">
        <Grid x:Name="ScrollContent">
            <ItemsControl x:Name="CardsHost"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Bottom">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical"
                                    Spacing="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </Grid>
    </ScrollViewer>
</UserControl>
