<?xml version="1.0" encoding="utf-8"?>
<!--
  Inline extract-config panel.

  Layout strategy: outer 2-row Grid — content (top, fills) + action row
  (bottom, pinned). Inside the content row a StackPanel groups title +
  destination + password + error so they stack naturally at the top
  without requiring a separate "*"-sized spacer row that swallows visual
  weight even when collapsed.

  All user-visible strings via x:Uid; all colors via {ThemeResource}.
-->
<UserControl
    x:Class="OtterZip.App.UserControls.ExtractPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="{StaticResource SpacingL}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================================================
             Content area — stacks naturally at the top.
             ============================================================ -->
        <StackPanel Grid.Row="0"
                    Spacing="{StaticResource SpacingSValue}"
                    VerticalAlignment="Top">

            <!-- Title row: archive filename + close (×). The filename is
                 the only thing that varies per archive so it gets the
                 SubtitleTextStyle weight; the close button is a quiet
                 icon-only secondary action. -->
            <Grid ColumnSpacing="{StaticResource SpacingSValue}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ArchiveNameText"
                           Grid.Column="0"
                           Style="{StaticResource SubtitleTextStyle}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <Button x:Name="CloseButton"
                        Grid.Column="1"
                        Style="{StaticResource IconButtonStyle}"
                        AutomationProperties.Name="Close"
                        Click="OnCloseClick">
                    <FontIcon Glyph="&#xE711;" FontSize="14" />
                </Button>
            </Grid>

            <!-- Destination label sits a bit closer to its input below
                 (Margin trims the parent StackPanel spacing for this
                 pairing only). -->
            <TextBlock x:Uid="ExtractDialog_DestinationLabel"
                       Style="{StaticResource CaptionTextStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Margin="0,8,0,-4" />
            <Grid ColumnSpacing="{StaticResource SpacingXSValue}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="180" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="DestinationField"
                         Grid.Column="0"
                         x:Uid="ExtractDialog_DestinationPlaceholder" />
                <Button x:Name="BrowseButton"
                        Grid.Column="1"
                        x:Uid="ExtractDialog_BrowseButton"
                        MinWidth="92"
                        Click="OnBrowseClick" />
            </Grid>

            <!-- Password row (hidden unless encrypted). Lock glyph +
                 PasswordBox in a single row reads as one affordance.
                 PlaceholderText is set from code-behind because the
                 resw entry uses .Text suffix and PasswordBox lacks
                 that property. -->
            <Grid x:Name="PasswordRow"
                  ColumnSpacing="{StaticResource SpacingSValue}"
                  Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon Grid.Column="0"
                          Glyph="&#xE72E;"
                          FontSize="14"
                          VerticalAlignment="Center"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <PasswordBox x:Name="PasswordField"
                             Grid.Column="1"
                             PasswordChanged="OnPasswordFieldChanged" />
            </Grid>

            <!-- Error caption (wrong password retry, etc). Collapsed
                 takes zero vertical space so the layout stays tight. -->
            <TextBlock x:Name="ErrorText"
                       Style="{StaticResource CaptionTextStyle}"
                       Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />
        </StackPanel>

        <!-- ============================================================
             Action row — pinned to the bottom of the panel.
             ============================================================ -->
        <Grid Grid.Row="1"
              ColumnSpacing="{StaticResource SpacingSValue}"
              Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="ExtractButton"
                    Grid.Column="1"
                    x:Uid="ExtractDialog_PrimaryButton"
                    Style="{StaticResource AccentButtonStyle}"
                    MinWidth="84"
                    Click="OnExtractClick" />
            <Button x:Name="ExtractHereButton"
                    Grid.Column="2"
                    x:Uid="ExtractDialog_SecondaryButton"
                    MinWidth="84"
                    Click="OnExtractHereClick" />
            <Button x:Name="CancelButton"
                    Grid.Column="3"
                    x:Uid="ExtractDialog_CancelButton"
                    MinWidth="60"
                    Click="OnCancelClick" />
        </Grid>
    </Grid>
</UserControl>
