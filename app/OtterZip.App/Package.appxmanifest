<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 mp com desktop4 rescap">

  <!--
    Partner Center reservation (LumiBear Studio account):
      Package Name              = LumiBearStudio.OtterZip
      Publisher ID              = CN=A55D3041-E7F5-46CB-8707-AD9C81D7CB43
      Publisher Display Name    = LumiBear Studio
      Package Family Name (PFN) = LumiBearStudio.OtterZip_zv1cz7a6mb9x2
      Store ID                  = 9NWQNGGSWJCL
      Store deep link           = ms-windows-store://pdp/?productid=9NWQNGGSWJCL

    These three fields (Identity Name + Publisher + PublisherDisplayName)
    MUST match the Partner Center reservation exactly or .msixupload
    ingestion fails with "package identity does not match the publisher
    information of the developer account that is signed in." Do not edit
    on a maintainer's local branch — re-issue from Partner Center if you
    rotate accounts.
  -->
  <Identity Name="LumiBearStudio.OtterZip"
            Publisher="CN=A55D3041-E7F5-46CB-8707-AD9C81D7CB43"
            Version="0.1.0.0" />

  <mp:PhoneIdentity PhoneProductId="00000000-0000-0000-0000-000000000000"
                    PhonePublisherId="00000000-0000-0000-0000-000000000000" />

  <Properties>
    <DisplayName>OtterZip</DisplayName>
    <PublisherDisplayName>LumiBear Studio</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop"
                        MinVersion="10.0.19041.0"
                        MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <!-- Tier-1 markets for global launch (ordered by Microsoft Store revenue weight). -->
    <Resource Language="en-US" />
    <Resource Language="zh-CN" />
    <Resource Language="ja-JP" />
    <Resource Language="ko-KR" />
    <Resource Language="de-DE" />
    <Resource Language="fr-FR" />
    <Resource Language="es-ES" />
    <Resource Language="pt-BR" />
    <Resource Language="ru-RU" />
    <Resource Language="it-IT" />
  </Resources>

  <Applications>
    <Application Id="App"
                 Executable="$targetnametoken$.exe"
                 EntryPoint="$targetentrypoint$">
      <uap:VisualElements DisplayName="OtterZip"
                          Description="Fast archive tool for Windows"
                          BackgroundColor="transparent"
                          Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>

      <!--
        Sprint 6 RC: real shell context menu wiring. Mirrors
        app/OtterZip.Shell/Package.Shell.appxmanifest.fragment.xml so the
        eventual MSIX bundle has the unified manifest in one place.
        See docs/03-api/shell-extension.md section 2.
      -->
      <Extensions>
        <!--
          File Type Associations - one per archive format so each gets its
          own per-format icon (with format-name badge) in Explorer when
          OtterZip is the user's default handler. Logo paths resolve to
          Assets\FileIcons\{format}\Icon.targetsize-N.png at runtime via MRT.

          Intentionally OMITTED (kept in context menu only):
            .appx .msix .msi - hijacking double-click would break the
            Windows package / installer flow.

          Generated by build/gen-fta-manifest.ps1 - re-run that script
          and regenerate this region if formats are added or renamed.
        -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="otterzip-zip">
            <uap:DisplayName>ZIP Archive</uap:DisplayName>
            <uap:Logo>Assets\FileIcons\zip\Icon.png</uap:Logo>
            <uap:InfoTip>OtterZip - ZIP Archive</uap:InfoTip>
            <uap:SupportedFileTypes>
              <uap:FileType>.zip</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="otterzip-zipx">
            <uap:DisplayName>ZIPX Archive</uap:DisplayName>
