<?xml version="1.0" encoding="utf-8"?>
<!--
  Settings → Integration tab. (UI rev: Fluent settings cards + 고급 Expander)
  그룹 "탐색기 메뉴"(메뉴 사용·표시 방식·여기에 풀기 기본) + 고급 Expander(진행 창 자동 닫기).
  코드비하인드 계약(x:Name·이벤트) 보존. 토글은 ToggleSwitch(IsOn/Toggled).
-->
<UserControl
    x:Class="OtterZip.App.Dialogs.IntegrationSettingsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
        <StackPanel Padding="{StaticResource SpacingL}" Spacing="6">

            <!-- ===== 탐색기 메뉴 ===== -->
            <TextBlock x:Uid="Settings_GroupShellMenu"
                       Style="{StaticResource SettingsSectionHeaderStyle}"
                       Margin="0,0,0,2" />

            <!-- 우클릭 메뉴 사용 -->
            <Border Style="{StaticResource CompactCardStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource SettingsIconChipStyle}">
                        <FontIcon Glyph="&#xE71D;" Style="{StaticResource SettingsCardIconStyle}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Uid="Settings_ShellMenuEnabled" Style="{StaticResource SettingsCardTitleStyle}" />
                        <TextBlock x:Uid="Settings_ShellMenuEnabledSub" Style="{StaticResource SettingsCardDescStyle}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2"
                                  x:Name="ShellMenuEnabledCheck"
                                  Style="{StaticResource SettingsCardToggleStyle}"
                                  Tag="Settings_ShellMenuEnabled"
                                  Toggled="OnToggle" />
                </Grid>
            </Border>

            <!-- 메뉴 표시 방식 (평면 / 하위 메뉴) -->
            <Border Style="{StaticResource CompactCardStyle}">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource SettingsIconChipStyle}">
                            <FontIcon Glyph="&#xEA37;" Style="{StaticResource SettingsCardIconStyle}" />
                        </Border>
                        <TextBlock Grid.Column="1"
                                   x:Uid="Settings_ShellMenuModeLabel"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource SettingsCardTitleStyle}" />
                    </Grid>
                    <RadioButtons x:Name="ShellMenuModeRadios"
                                  MaxColumns="1"
                                  Margin="44,0,0,0"
                                  SelectionChanged="OnShellMenuModeChanged">
                        <RadioButton x:Uid="Settings_ShellMenuModeFlat"   Tag="flat" />
                        <RadioButton x:Uid="Settings_ShellMenuModeNested" Tag="nested" />
                    </RadioButtons>
                </StackPanel>
            </Border>

            <!-- ===== 고급 (점진적 노출) ===== -->
            <Expander HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      Margin="0,12,0,0">
                <Expander.Header>
                    <Grid ColumnSpacing="12" Padding="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource SettingsIconChipStyle}">
                            <FontIcon Glyph="&#xE713;" Style="{StaticResource SettingsCardIconStyle}" />
                        </Border>
                        <TextBlock Grid.Column="1"
                                   x:Uid="Settings_GroupAdvanced"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource SettingsCardTitleStyle}" />
                    </Grid>
                </Expander.Header>
                <StackPanel Spacing="6" Padding="0,4,0,4">
                    <!-- 빠른 압축 진행 창 자동 닫기 -->
                    <Border Style="{StaticResource CompactCardStyle}">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource SettingsIconChipStyle}">
                                <FontIcon Glyph="&#xE916;" Style="{StaticResource SettingsCardIconStyle}" />
                            </Border>
                            <TextBlock Grid.Column="1"
                                       x:Uid="Settings_QuickProgressAutoClose"
                                       Style="{StaticResource SettingsCardTitleStyle}" />
                            <ToggleSwitch Grid.Column="2"
                                          x:Name="QuickProgressAutoCloseCheck"
                                          Style="{StaticResource SettingsCardToggleStyle}"
                                          Tag="Settings_QuickProgressAutoClose"
                                          Toggled="OnToggle" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
