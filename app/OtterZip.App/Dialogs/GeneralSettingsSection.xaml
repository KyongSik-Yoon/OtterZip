<?xml version="1.0" encoding="utf-8"?>
<!--
  Settings → General tab. (UI rev: Fluent settings cards + groups)
  그룹: 기본값(언어·테마·기본 동작·동시 작업 수) / 알림(종료 확인·Toast) + 기본 프로그램 버튼.
  코드비하인드 계약(x:Name·이벤트) 보존. 토글은 ToggleSwitch(IsOn/Toggled).
-->
<UserControl
    x:Class="OtterZip.App.Dialogs.GeneralSettingsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
        <StackPanel Padding="{StaticResource SpacingL}" Spacing="6">

            <!-- ===== 기본값 ===== -->
            <TextBlock x:Uid="Settings_GroupDefaults"
                       Style="{StaticResource SettingsSectionHeaderStyle}"
                       Margin="0,0,0,2" />

            <!-- 언어 -->
            <Border Style="{StaticResource CompactCardStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource SettingsIconChipStyle}">
                        <FontIcon Glyph="&#xF2B7;" Style="{StaticResource SettingsCardIconStyle}" />
                    </Border>
                    <TextBlock Grid.Column="1"
                               x:Uid="Settings_LanguageLabel"
                               Style="{StaticResource SettingsCardTitleStyle}" />
                    <ComboBox Grid.Column="2"
                              x:Name="LanguageCombo"
                              MinWidth="170"
                              VerticalAlignment="Center"
                              SelectionChanged="OnLanguageChanged">
                        <ComboBoxItem x:Uid="Settings_LanguageSystem" Tag="" />
                        <ComboBoxItem x:Uid="Settings_LanguageKo"     Tag="ko" />
                        <ComboBoxItem x:Uid="Settings_LanguageEn"     Tag="en" />
                        <ComboBoxItem x:Uid="Settings_LanguageZh"     Tag="zh" />
                        <ComboBoxItem x:Uid="Settings_LanguageJa"     Tag="ja" />
                        <ComboBoxItem x:Uid="Settings_LanguageDe"     Tag="de" />
                        <ComboBoxItem x:Uid="Settings_LanguageFr"     Tag="fr" />
                        <ComboBoxItem x:Uid="Settings_LanguageEs"     Tag="es" />
                        <ComboBoxItem x:Uid="Settings_LanguagePt"     Tag="pt" />
                        <ComboBoxItem x:Uid="Settings_LanguageRu"     Tag="ru" />
                        <ComboBoxItem x:Uid="Settings_LanguageIt"     Tag="it" />
                    </ComboBox>
                </Grid>
            </Border>

            <!-- 테마 -->
            <Border Style="{StaticResource CompactCardStyle}">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource SettingsIconChipStyle}">
                            <FontIcon Glyph="&#xE771;" Style="{StaticResource SettingsCardIconStyle}" />
                        </Border>
                        <TextBlock Grid.Column="1"
                                   x:Uid="Settings_ThemeSectionLabel"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource SettingsCardTitleStyle}" />
                    </Grid>
                    <RadioButtons x:Name="ThemeRadioButtons"
                                  MaxColumns="1"
                                  Margin="44,0,0,0"
                                  SelectionChanged="OnThemeSelectionChanged">
                        <RadioButton x:Uid="Theme_System" Tag="0" />
                        <RadioButton x:Uid="Theme_Light"  Tag="1" />
                        <RadioButton x:Uid="Theme_Dark"   Tag="2" />
                    </RadioButtons>
                </StackPanel>
            </Border>

            <!-- 기본 동작 -->
            <Border Style="{StaticResource CompactCardStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource SettingsIconChipStyle}">
                        <FontIcon Glyph="&#xE7C4;" Style="{StaticResource SettingsCardIconStyle}" />
                    </Border>
                    <TextBlock Grid.Column="1"
                               x:Uid="Settings_DefaultActionLabel"
                               Style="{StaticResource SettingsCardTitleStyle}" />
                    <ComboBox Grid.Column="2"
                              x:Name="DefaultActionCombo"
                              MinWidth="170"
                              VerticalAlignment="Center"
                              SelectionChanged="OnDefaultActionChanged">
                        <ComboBoxItem x:Uid="Settings_DefaultActionAuto"     Tag="auto" />
                        <ComboBoxItem x:Uid="Settings_DefaultActionCompress" Tag="compress" />
                        <ComboBoxItem x:Uid="Settings_DefaultActionExtract"  Tag="extract" />
                    </ComboBox>
                </Grid>
            </Border>

            <!-- 동시 작업 수 -->
            <Border Style="{StaticResource CompactCardStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource SettingsIconChipStyle}">
                        <FontIcon Glyph="&#xE9D9;" Style="{StaticResource SettingsCardIconStyle}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Uid="Settings_ConcurrentJobsLabel" Style="{StaticResource SettingsCardTitleStyle}" />
                        <TextBlock x:Uid="Settings_ConcurrentJobsSub" Style="{StaticResource SettingsCardDescStyle}" />
                    </StackPanel>
                    <ComboBox Grid.Column="2"
                              x:Name="ConcurrentJobsCombo"
                              MinWidth="100"
                              VerticalAlignment="Center"
                              SelectionChanged="OnConcurrentJobsChanged">
                        <ComboBoxItem Content="1" Tag="1" />
                        <ComboBoxItem Content="2" Tag="2" />
                        <ComboBoxItem Content="3" Tag="3" />
                        <ComboBoxItem Content="4" Tag="4" />
                    </ComboBox>
                </Grid>
            </Border>

            <!-- ===== 알림 ===== -->
            <TextBlock x:Uid="Settings_GroupNotifications"
                       Style="{StaticResource SettingsSectionHeaderStyle}"
                       Margin="0,12,0,2" />

            <!-- 진행 중 종료 확인 -->
            <Border Style="{StaticResource CompactCardStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource SettingsIconChipStyle}">
                        <FontIcon Glyph="&#xE7BA;" Style="{StaticResource SettingsCardIconStyle}" />
                    </Border>
                    <TextBlock Grid.Column="1"
                               x:Uid="Settings_ConfirmExitWhileBusy"
                               Style="{StaticResource SettingsCardTitleStyle}" />
                    <ToggleSwitch Grid.Column="2"
                                  x:Name="ConfirmExitCheck"
                                  Style="{StaticResource SettingsCardToggleStyle}"
                                  Tag="Settings_ConfirmExitWhileBusy"
                                  Toggled="OnToggle" />
                </Grid>
            </Border>

            <!-- 알림(Toast) 사용 -->
            <Border Style="{StaticResource CompactCardStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource SettingsIconChipStyle}">
                        <FontIcon Glyph="&#xEA8F;" Style="{StaticResource SettingsCardIconStyle}" />
                    </Border>
                    <TextBlock Grid.Column="1"
                               x:Uid="Settings_ShowToast"
                               Style="{StaticResource SettingsCardTitleStyle}" />
                    <ToggleSwitch Grid.Column="2"
                                  x:Name="ShowToastCheck"
                                  Style="{StaticResource SettingsCardToggleStyle}"
                                  Tag="Settings_ShowToast"
                                  Toggled="OnToggle" />
                </Grid>
            </Border>

            <!-- 기본 프로그램 설정 (Windows 기본 앱 딥링크) -->
            <Button x:Uid="Settings_OpenDefaultApps"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Left"
                    Click="OnOpenDefaultApps" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
