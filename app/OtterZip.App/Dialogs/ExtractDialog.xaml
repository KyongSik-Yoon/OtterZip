<?xml version="1.0" encoding="utf-8"?>
<!--
  Sprint A — S5 추출 다이얼로그.
  - Primary 버튼: 사용자가 입력한 폴더로 추출
  - Secondary 버튼: 아카이브 옆 sibling 폴더로 즉시 추출 ("여기에 풀기")
  - Cancel 버튼: 작업 취소
  Title은 코드비하인드에서 ResourceLoader로 포맷 (`{0}` = 파일명).
-->
<ContentDialog
    x:Class="OtterZip.App.Dialogs.ExtractDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    DefaultButton="Primary">

    <!--
      MinWidth bumped 380 -> 460 + Browse button MinWidth pinned to 92px
      so the Korean label "찾아보기" doesn't get clipped when the
      destination path is long. Without these the Auto column shrunk
      below the text bounds.
    -->
    <StackPanel Spacing="{StaticResource SpacingSValue}"
                MinWidth="460">

        <TextBlock x:Uid="ExtractDialog_DestinationLabel"
                   Style="{StaticResource CaptionTextStyle}" />

        <Grid ColumnSpacing="{StaticResource SpacingXSValue}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="220" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox x:Name="DestinationField"
                     Grid.Column="0"
                     x:Uid="ExtractDialog_DestinationPlaceholder" />

            <Button x:Name="BrowseButton"
                    Grid.Column="1"
                    x:Uid="ExtractDialog_BrowseButton"
                    MinWidth="92"
                    Click="OnBrowseClick" />
        </Grid>

    </StackPanel>
</ContentDialog>
