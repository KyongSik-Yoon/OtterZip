<?xml version="1.0" encoding="utf-8"?>
<!--
  Settings → Info tab. Version + License/Third-Party links + unrar notice.
-->
<UserControl
    x:Class="OtterZip.App.Dialogs.InfoSettingsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel Spacing="{StaticResource SpacingMValue}"
                Padding="{StaticResource SpacingL}">

        <Grid ColumnSpacing="{StaticResource SpacingMValue}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       x:Uid="Settings_VersionLabel"
                       Style="{StaticResource BodyTextStyle}" />
            <TextBlock Grid.Column="1"
                       x:Name="VersionText"
                       Style="{StaticResource BodyStrongTextStyle}"
                       TextWrapping="Wrap" />
        </Grid>

        <StackPanel Orientation="Horizontal"
                    Spacing="{StaticResource SpacingSValue}">
            <Button x:Uid="Settings_OpenLicense" Click="OnOpenLicense" />
            <Button x:Uid="Settings_OpenThirdParty" Click="OnOpenThirdParty" />
        </StackPanel>

        <TextBlock x:Uid="Settings_UnrarNotice"
                   Style="{StaticResource CaptionTextStyle}"
                   TextWrapping="Wrap"
                   Margin="0,8,0,0"
                   Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

        <!-- Telemetry opt-in (PR-7F) — placed at the bottom of Info so the
             user reads the unrar notice + privacy context before flipping. -->
        <Border Margin="0,12,0,0" />
        <StackPanel>
            <CheckBox x:Name="TelemetryEnabledCheck"
                      x:Uid="Settings_TelemetryEnabled"
                      MinHeight="0"
                      Checked="OnTelemetryToggle"
                      Unchecked="OnTelemetryToggle" />
            <TextBlock x:Uid="Settings_TelemetryEnabledSub"
                       Style="{StaticResource CaptionTextStyle}"
                       TextWrapping="Wrap"
                       Margin="28,0,0,2"
                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
        </StackPanel>
    </StackPanel>
</UserControl>
