<?xml version="1.0" encoding="utf-8"?>
<!--
  Settings → Compression tab. (Phase 6+ rev 3)
  9 items: defaultFormat, defaultMethod, saveLocation, useParentFolderName,
           excludeSystemMeta, verifyAfterCompress, alwaysPromptPassword,
           playSound, reveal+deleteSource (paired toggles).
-->
<UserControl
    x:Class="OtterZip.App.Dialogs.CompressionSettingsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
        <StackPanel Spacing="{StaticResource SpacingSValue}"
                    Padding="{StaticResource SpacingL}">

            <Grid ColumnSpacing="{StaticResource SpacingMValue}"
                  RowSpacing="{StaticResource SpacingSValue}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Default format -->
                <TextBlock Grid.Row="0" Grid.Column="0"
                           x:Uid="Settings_DefaultFormatLabel"
                           VerticalAlignment="Center"
                           Style="{StaticResource BodyTextStyle}" />
                <ComboBox Grid.Row="0" Grid.Column="1"
                          x:Name="DefaultFormatCombo"
                          HorizontalAlignment="Stretch"
                          SelectionChanged="OnDefaultFormatChanged">
                    <ComboBoxItem Content="ZIP"     Tag="ZIP" />
                    <ComboBoxItem Content="7z"      Tag="7z" />
                    <ComboBoxItem Content="tar"     Tag="tar" />
                    <ComboBoxItem Content="tar.gz"  Tag="tar.gz" />
                    <ComboBoxItem Content="tar.bz2" Tag="tar.bz2" />
                    <ComboBoxItem Content="tar.xz"  Tag="tar.xz" />
                </ComboBox>

                <!-- Default method -->
                <TextBlock Grid.Row="1" Grid.Column="0"
                           x:Uid="Settings_DefaultMethodLabel"
                           VerticalAlignment="Center"
                           Style="{StaticResource BodyTextStyle}" />
                <ComboBox Grid.Row="1" Grid.Column="1"
                          x:Name="DefaultMethodCombo"
                          HorizontalAlignment="Stretch"
                          SelectionChanged="OnDefaultMethodChanged">
                    <ComboBoxItem x:Uid="Settings_MethodStore"  Tag="0" />
                    <ComboBoxItem x:Uid="Settings_MethodFast"   Tag="1" />
                    <ComboBoxItem x:Uid="Settings_MethodNormal" Tag="2" />
                    <ComboBoxItem x:Uid="Settings_MethodBest"   Tag="3" />
                </ComboBox>

                <!-- Save location -->
                <TextBlock Grid.Row="2" Grid.Column="0"
                           x:Uid="Settings_SaveLocationLabel"
                           VerticalAlignment="Top"
                           Margin="0,8,0,0"
                           Style="{StaticResource BodyTextStyle}" />
                <StackPanel Grid.Row="2" Grid.Column="1"
                            Spacing="{StaticResource SpacingXSValue}">
                    <RadioButtons x:Name="SaveLocationRadios"
                                  MaxColumns="1"
                                  SelectionChanged="OnSaveLocationChanged">
                        <RadioButton x:Uid="Settings_SaveLocationSame"   Tag="same" />
                        <RadioButton x:Uid="Settings_SaveLocationCustom" Tag="custom" />
                    </RadioButtons>
                    <Grid x:Name="SaveLocationCustomRow"
                          ColumnSpacing="{StaticResource SpacingSValue}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 x:Name="SaveLocationPathBox"
                                 IsReadOnly="True" />
                        <Button Grid.Column="1"
                                x:Uid="Settings_BrowseButton"
                                Click="OnBrowseSaveLocation" />
                    </Grid>
                </StackPanel>
            </Grid>

            <!-- Section break -->
            <Border Margin="0,8,0,0" />

            <CheckBox x:Name="UseParentFolderNameCheck"
                      x:Uid="Settings_UseParentFolderName"
                      MinHeight="0"
                      Checked="OnToggle"
                      Unchecked="OnToggle"
                      Tag="Settings_UseParentFolderName" />

            <!-- Filename template (PR-7B) -->
            <StackPanel Spacing="2"
                        Margin="0,8,0,0">
                <TextBlock x:Uid="Settings_FilenameTemplateLabel"
                           Style="{StaticResource BodyTextStyle}" />
                <TextBox x:Name="FilenameTemplateBox"
                         x:Uid="Settings_FilenameTemplatePlaceholder"
                         TextChanged="OnFilenameTemplateChanged" />
                <TextBlock x:Uid="Settings_FilenameTemplateSub"
                           Style="{StaticResource CaptionTextStyle}"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>

            <StackPanel>
                <CheckBox x:Name="ExcludeSystemMetadataCheck"
                          x:Uid="Settings_ExcludeSystemMetadata"
                          MinHeight="0"
                          Checked="OnToggle"
                          Unchecked="OnToggle"
                          Tag="Settings_ExcludeSystemMetadata" />
                <TextBlock x:Uid="Settings_ExcludeSystemMetadataSub"
                           Style="{StaticResource CaptionTextStyle}"
                           Margin="28,0,0,2"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>

            <CheckBox x:Name="VerifyAfterCompressCheck"
                      x:Uid="Settings_VerifyAfterCompress"
                      MinHeight="0"
                      Checked="OnToggle"
                      Unchecked="OnToggle"
                      Tag="Settings_VerifyAfterCompress" />

            <CheckBox x:Name="AlwaysPromptPasswordCheck"
                      x:Uid="Settings_AlwaysPromptPassword"
                      MinHeight="0"
                      Checked="OnToggle"
                      Unchecked="OnToggle"
                      Tag="Settings_AlwaysPromptPassword" />

            <Border Margin="0,8,0,0" />

            <CheckBox x:Name="PlaySoundOnCompressCheck"
                      x:Uid="Settings_PlaySoundOnCompress"
                      MinHeight="0"
                      Checked="OnToggle"
                      Unchecked="OnToggle"
                      Tag="Settings_PlaySoundOnCompress" />

            <CheckBox x:Name="RevealAfterCompressCheck"
                      x:Uid="Settings_RevealAfterCompress"
                      MinHeight="0"
                      Checked="OnToggle"
                      Unchecked="OnToggle"
                      Tag="Settings_RevealAfterCompress" />

            <CheckBox x:Name="DeleteSourceAfterCompressCheck"
                      x:Uid="Settings_DeleteSourceAfterCompress"
                      MinHeight="0"
                      Checked="OnToggle"
                      Unchecked="OnToggle"
                      Tag="Settings_DeleteSourceAfterCompress" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
