<?xml version="1.0" encoding="utf-8"?>
<!--
  Settings → Password tab. (UI rev: Fluent settings cards + groups)
  기본 비밀번호 입력 카드 + 그룹 "자동 적용"(압축 시 / 해제 시 / 사용 전 인증).
  코드비하인드 계약(x:Name·이벤트) 보존. 토글은 ToggleSwitch(IsOn/Toggled).
-->
<UserControl
    x:Class="OtterZip.App.Dialogs.PasswordSettingsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
        <StackPanel Padding="{StaticResource SpacingL}" Spacing="6">

            <!-- 기본 비밀번호 -->
            <Border Style="{StaticResource CompactCardStyle}">
                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource SettingsIconChipStyle}">
                            <FontIcon Glyph="&#xE192;" Style="{StaticResource SettingsCardIconStyle}" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock x:Uid="Settings_DefaultPasswordLabel" Style="{StaticResource SettingsCardTitleStyle}" />
                            <TextBlock x:Uid="Settings_DefaultPasswordDesc" Style="{StaticResource SettingsCardDescStyle}" />
                        </StackPanel>
                    </Grid>
                    <PasswordBox x:Name="DefaultPasswordBox"
                                 x:Uid="Settings_DefaultPasswordPlaceholder"
                                 Margin="44,0,0,0"
                                 PasswordChanged="OnPasswordChanged" />
                </StackPanel>
            </Border>

            <!-- ===== 자동 적용 ===== -->
            <TextBlock x:Uid="Settings_GroupAutoApply"
                       Style="{StaticResource SettingsSectionHeaderStyle}"
                       Margin="0,12,0,2" />

            <!-- 압축 시 자동 적용 -->
            <Border Style="{StaticResource CompactCardStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource SettingsIconChipStyle}">
                        <FontIcon Glyph="&#xE8B7;" Style="{StaticResource SettingsCardIconStyle}" />
                    </Border>
                    <TextBlock Grid.Column="1"
                               x:Uid="Settings_DefaultPasswordOnCompress"
                               Style="{StaticResource SettingsCardTitleStyle}" />
                    <ToggleSwitch Grid.Column="2"
                                  x:Name="OnCompressCheck"
                                  Style="{StaticResource SettingsCardToggleStyle}"
                                  Tag="Settings_DefaultPasswordOnCompress"
                                  Toggled="OnToggle" />
                </Grid>
            </Border>

            <!-- 압축 해제 시 자동 적용 -->
            <Border Style="{StaticResource CompactCardStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource SettingsIconChipStyle}">
                        <FontIcon Glyph="&#xE838;" Style="{StaticResource SettingsCardIconStyle}" />
                    </Border>
                    <TextBlock Grid.Column="1"
                               x:Uid="Settings_DefaultPasswordOnExtract"
                               Style="{StaticResource SettingsCardTitleStyle}" />
                    <ToggleSwitch Grid.Column="2"
                                  x:Name="OnExtractCheck"
                                  Style="{StaticResource SettingsCardToggleStyle}"
                                  Tag="Settings_DefaultPasswordOnExtract"
                                  Toggled="OnToggle" />
                </Grid>
            </Border>

            <!-- 사용 전 인증 -->
            <Border Style="{StaticResource CompactCardStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource SettingsIconChipStyle}">
                        <FontIcon Glyph="&#xE928;" Style="{StaticResource SettingsCardIconStyle}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Uid="Settings_AuthBeforeUseDefaultPassword" Style="{StaticResource SettingsCardTitleStyle}" />
                        <TextBlock x:Uid="Settings_AuthBeforeUseDefaultPasswordSub" Style="{StaticResource SettingsCardDescStyle}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2"
                                  x:Name="AuthBeforeUseCheck"
                                  Style="{StaticResource SettingsCardToggleStyle}"
                                  Tag="Settings_AuthBeforeUseDefaultPassword"
                                  Toggled="OnToggle" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
