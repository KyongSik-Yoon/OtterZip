<?xml version="1.0" encoding="utf-8"?>
<!--
  Settings → Password tab. (Phase 6+ rev 3)
  4 items: defaultPassword + onCompress / onExtract auto-apply + auth-before-use.
  Storage backend in MVP is LocalSettings (Windows DPAPI auto-encrypts);
  Credential Manager + Hello integration arrives in v1.1.
-->
<UserControl
    x:Class="OtterZip.App.Dialogs.PasswordSettingsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
        <StackPanel Spacing="{StaticResource SpacingSValue}"
                    Padding="{StaticResource SpacingL}">

            <Grid ColumnSpacing="{StaticResource SpacingMValue}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           x:Uid="Settings_DefaultPasswordLabel"
                           VerticalAlignment="Center"
                           Style="{StaticResource BodyTextStyle}" />
                <PasswordBox Grid.Column="1"
                             x:Name="DefaultPasswordBox"
                             x:Uid="Settings_DefaultPasswordPlaceholder"
                             PasswordChanged="OnPasswordChanged" />
            </Grid>

            <Border Margin="0,8,0,0" />

            <CheckBox x:Name="OnCompressCheck"
                      x:Uid="Settings_DefaultPasswordOnCompress"
                      MinHeight="0"
                      Checked="OnToggle"
                      Unchecked="OnToggle"
                      Tag="Settings_DefaultPasswordOnCompress" />

            <CheckBox x:Name="OnExtractCheck"
                      x:Uid="Settings_DefaultPasswordOnExtract"
                      MinHeight="0"
                      Checked="OnToggle"
                      Unchecked="OnToggle"
                      Tag="Settings_DefaultPasswordOnExtract" />

            <StackPanel>
                <CheckBox x:Name="AuthBeforeUseCheck"
                          x:Uid="Settings_AuthBeforeUseDefaultPassword"
                          MinHeight="0"
                          Checked="OnToggle"
                          Unchecked="OnToggle"
                          Tag="Settings_AuthBeforeUseDefaultPassword" />
                <TextBlock x:Uid="Settings_AuthBeforeUseDefaultPasswordSub"
                           Style="{StaticResource CaptionTextStyle}"
                           TextWrapping="Wrap"
                           Margin="28,0,0,2"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
