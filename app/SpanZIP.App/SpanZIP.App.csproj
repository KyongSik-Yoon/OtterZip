<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Configuration 분기:
      - Debug   = Unpackaged (WindowsPackageType=None) → F5 빠른 디버깅, 셸 확장 비활성
      - Release = MSIX (WindowsPackageType=MSIX) → VS Deploy 메뉴 활성, 셸 확장 사이드로드 가능
    AOT는 MSIX 패키징과 호환되지 않으므로 build-msix.bat에서 /p:PublishAot=false로 강제 override.
    AOT 트림 안전 검증은 tools/aot-check.ps1에서 별도로 실행.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>SpanZIP.App</RootNamespace>
    <AssemblyName>SpanZIP</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>

    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>

    <!--
      Debug = Unpackaged (빠른 F5)
      Release = MSIX (VS의 "현재 PC에 배포" 메뉴 활성, 셸 확장 검증 가능)
    -->
    <WindowsPackageType Condition="'$(Configuration)' == 'Debug'">None</WindowsPackageType>
    <WindowsPackageType Condition="'$(Configuration)' != 'Debug'">MSIX</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>

    <InvariantGlobalization>false</InvariantGlobalization>
    <Nullable>enable</Nullable>

    <!--
      PublishAot:
      - MSIX 패키징과 호환되지 않으므로 기본값에서 비활성.
      - AOT 검증이 필요하면 tools/aot-check.ps1을 통해 별도 publish 시 활성.
      - 과거 'Release일 때 AOT' 설정은 MSIX 전환과 충돌하여 제거.
    -->
    <!-- <PublishAot Condition="'$(Configuration)' == 'Release'">true</PublishAot> -->

    <!-- Suppress analyzer rules incompatible with WinUI 3 codegen:
         CA1515: XAML codegen forces public partial classes
         CA1724/MA0049: App class name == SpanZIP.App namespace (WinUI convention)
         CA1003/MA0046: WinRT TypedEventHandler pattern, not EventHandler<T>
         CA5392: WindowsAppSDK-internal UndockedRegFreeWinRT P/Invoke
         CA1031: Defensive catch-all required in UI drop handlers
         IL2026 / IL3050 (Sprint 6 RC): Microsoft.Web.WebView2 is a transitive
            WindowsAppSDK 1.6 dep that surfaces non-AOT-safe header projections.
            We don't use WebView2; the pruned-but-still-warned symbols are
            unreachable code. Microsoft tracker: WindowsAppSDK#9114. -->
    <NoWarn>$(NoWarn);CA1515;CA1724;CA1003;CA1031;CA1822;CA5392;MA0046;MA0049;IL2026;IL3050</NoWarn>
  </PropertyGroup>

  <!--
    VS UI integration — what makes "Project right-click → Deploy"
    and "Package and Publish" menus actually appear.

    Side-by-side analysis with a known-working WinUI 3 project
    (LumiFiles) showed our csproj had every packaging *property*
    set correctly (GenerateAppxPackageOnBuild, signing thumbprint,
    AppxPackageDir, etc.) but was missing the two **capability**
    declarations VS reads to decide whether a project is an MSIX
    target at all. Without these two tags VS treats the project
    as a plain WinExe, hides the Deploy / Package menus, and the
    .sln Deploy.0 line we added earlier sits idle.

    The conditions match LumiFiles's pattern verbatim so the
    `Disable*` opt-out hooks keep working for any future tooling
    that wants to suppress them.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.CodeAnalysis.NetAnalyzers" />
    <PackageReference Include="Meziantou.Analyzer" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SpanZIP.Interop\SpanZIP.Interop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    PR-7D: Bundle the C++/WinRT shell extension (SpanZIP.Shell.dll)
    into the MSIX so Explorer's right-click menu picks it up.
    Without this Target the host EXE installs cleanly but no
    SpanZIP entry appears in the context menu, because the shell
    DLL never makes it into Program Files\WindowsApps\SpanZIP.SpanZIP_*.

    Pattern adapted from LumiFiles's IncludeThumbsInPackage Target
    (LumiFiles\LumiFiles.csproj). Inject the Content item BEFORE
    AssignTargetPaths so MSIX packaging treats it like any other
    content file. The Shell vcxproj must be built separately
    (build-msix.bat handles that, or run msbuild
    SpanZIP.Shell.vcxproj /p:Configuration=Release /p:Platform=x64
    standalone). This Target only stages the output; it does not
    invoke the C++ build itself.
  -->
  <Target Name="IncludeShellExtensionInPackage"
          BeforeTargets="AssignTargetPaths;GetCopyToOutputDirectoryItems"
          Condition="'$(WindowsPackageType)' != 'None'">
    <PropertyGroup>
      <_ShellBinDir>$(MSBuildThisFileDirectory)..\SpanZIP.Shell\$(Platform)\$(Configuration)\</_ShellBinDir>
    </PropertyGroup>
    <ItemGroup Condition="Exists('$(_ShellBinDir)SpanZIP.Shell.dll')">
      <Content Include="$(_ShellBinDir)SpanZIP.Shell.dll"
               Link="SpanZIP.Shell.dll"
               CopyToOutputDirectory="Always"
               Visible="false" />
    </ItemGroup>
    <Warning Condition="!Exists('$(_ShellBinDir)SpanZIP.Shell.dll')"
             Text="SpanZIP.Shell.dll not found at $(_ShellBinDir). Right-click context menu will be inactive. Build SpanZIP.Shell.vcxproj first." />
  </Target>

  <!--
    Sprint 6 RC: keep the manifest under source control so MSIX packaging
    sees it, but only attach it when MSIX tooling is actually enabled.
    Unpackaged dev build (WindowsPackageType=None) ignores it.
  -->
  <ItemGroup Condition="'$(WindowsPackageType)' != 'None'">
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
  </ItemGroup>

  <!--
    Visual Studio "Project right-click → Deploy" menu activation.
    These properties are only meaningful when WindowsPackageType=MSIX
    (= Release in our branch). They tell the MSBuild MSIX targets to:
      1. Generate the .msix during the build (not just publish).
      2. Sign it with the dev cert checked into build/ (paired with
         the dev-cert.pfx that tools/dev-cert.ps1 produces).
      3. Drop the output under bin/<Config>/<Platform>/AppPackages so
         VS knows where to look when invoking Add-AppxPackage.
    `build-msix.bat` already passes these as `/p:` overrides; codifying
    them here lets the IDE's Deploy command work without the batch
    script.
  -->
  <PropertyGroup Condition="'$(WindowsPackageType)' != 'None'">
    <GenerateAppxPackageOnBuild>true</GenerateAppxPackageOnBuild>
    <AppxBundle>Never</AppxBundle>
    <UapAppxPackageBuildMode>SideloadOnly</UapAppxPackageBuildMode>
    <AppxPackageDir>$(MSBuildThisFileDirectory)bin\$(Configuration)\$(Platform)\AppPackages\</AppxPackageDir>
    <AppxPackageSigningEnabled>true</AppxPackageSigningEnabled>
    <!--
      The .NET SDK MSIX targets ignore PackageCertificatePassword
      (that pair is wapproj-specific). For VS Deploy to sign the
      package automatically the cert must live in the user's
      personal certificate store and be referenced by thumbprint.
      Onboarding step (run once on a new dev machine):

          $pwd = ConvertTo-SecureString "spanzip-dev-only" `
                   -AsPlainText -Force
          Import-PfxCertificate `
              -FilePath build\dev-cert.pfx `
              -CertStoreLocation Cert:\CurrentUser\My `
              -Password $pwd

      Thumbprint below matches the dev-cert.pfx checked into
      build/. Regenerating the cert (tools/dev-cert.ps1) requires
      updating both this value and build/dev-cert.thumbprint.txt.
    -->
    <PackageCertificateThumbprint>61A88ECD6F4BEFC512B38EC2910F0D7D43D13788</PackageCertificateThumbprint>
    <!-- AOT incompatible with MSIX packaging — explicit OFF so VS
         Deploy doesn't accidentally enable it for Release. -->
    <PublishAot>false</PublishAot>
    <PublishTrimmed>false</PublishTrimmed>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

</Project>
