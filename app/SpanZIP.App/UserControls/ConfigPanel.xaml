<?xml version="1.0" encoding="utf-8"?>
<!--
  ConfigPanel — Phase 6+ rev 5 simplified layout.

  Main visible surface (always shown):
    1. Format card (the only frequently-changed primary)
    2. Drop hint card — visual cue + click-to-pick fallback

  Behind the Advanced expander (collapsed by default):
    3. Split card
    4. Password card (+ AES-256)
    5. Bottom checkboxes (system meta / verify / delete source / separately)

  Hard rules:
    - All user-visible text via x:Uid → .resw keys
    - All colors via {ThemeResource ...}
-->
<UserControl
    x:Class="SpanZIP.App.UserControls.ConfigPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Uid="ConfigPanel_Region">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollMode="Disabled"
                  Padding="0">

        <StackPanel Spacing="{StaticResource SpacingXSValue}"
                    Padding="{StaticResource SpacingS}">

            <!-- ================================================================ -->
            <!--  Card 0: Format (only primary always visible)                    -->
            <!-- ================================================================ -->
            <Border Style="{StaticResource CompactCardStyle}"
                    PointerEntered="OnCardPointerEntered"
                    PointerExited="OnCardPointerExited">
                <Grid ColumnSpacing="{StaticResource SpacingSValue}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="64" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <FontIcon Grid.Column="0"
                              FontFamily="{StaticResource SymbolThemeFontFamily}"
                              Glyph="&#xE7C3;"
                              FontSize="14"
                              VerticalAlignment="Center"
                              Margin="2,0,4,0"
                              Foreground="{ThemeResource SpanzipBrandBrush}" />

                    <TextBlock Grid.Column="1"
                               x:Uid="ConfigPanel_FormatLabel"
                               VerticalAlignment="Center"
                               Style="{StaticResource CardHeaderLabelStyle}" />

                    <ComboBox Grid.Column="2"
                              x:Name="FormatCombo"
                              HorizontalAlignment="Stretch"
                              SelectedIndex="0"
                              SelectionChanged="OnFormatChanged">
                        <ComboBoxItem x:Uid="ConfigPanel_FormatZip" Tag="ZIP" />
                        <ComboBoxItem x:Uid="ConfigPanel_FormatSevenZ" Tag="7z" />
                        <ComboBoxItem x:Uid="ConfigPanel_FormatTar" Tag="tar" />
                        <ComboBoxItem x:Uid="ConfigPanel_FormatTarGz" Tag="tar.gz" />
                        <ComboBoxItem x:Uid="ConfigPanel_FormatTarBz2" Tag="tar.bz2" />
                        <ComboBoxItem x:Uid="ConfigPanel_FormatTarXz" Tag="tar.xz" />
                    </ComboBox>
                </Grid>
            </Border>

            <!-- ================================================================ -->
            <!--  Drop Hint — primary visual + click-to-pick fallback             -->
            <!-- ================================================================ -->
            <Border x:Name="DropHintCard"
                    MinHeight="180"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="16"
                    Tapped="OnDropHintTapped"
                    PointerEntered="OnCardPointerEntered"
                    PointerExited="OnCardPointerExited">
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="6">
                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}"
                              Glyph="&#xE898;"
                              FontSize="48"
                              Foreground="{ThemeResource SpanzipBrandBrush}"
                              Opacity="0.85"
                              HorizontalAlignment="Center" />
                    <TextBlock x:Uid="ConfigPanel_DropHintTitle"
                               Style="{StaticResource BodyStrongTextStyle}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center" />
                    <TextBlock x:Uid="ConfigPanel_DropHintSubtitle"
                               Style="{StaticResource CaptionTextStyle}"
                               Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- ================================================================ -->
            <!--  Advanced expander — Split / Password / 4 checkboxes              -->
            <!-- ================================================================ -->
            <Expander x:Name="AdvancedExpander"
                      x:Uid="ConfigPanel_AdvancedExpander"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch"
                      Margin="0,4,0,0"
                      Expanding="OnAdvancedExpanderToggled"
                      Collapsed="OnAdvancedExpanderToggled">
                <StackPanel Spacing="{StaticResource SpacingXSValue}">

                    <!-- Card 2: Split -->
                    <Border Style="{StaticResource CompactCardStyle}"
                            PointerEntered="OnCardPointerEntered"
                            PointerExited="OnCardPointerExited">
                        <Grid ColumnSpacing="{StaticResource SpacingSValue}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <FontIcon Grid.Column="0"
                                      FontFamily="{StaticResource SymbolThemeFontFamily}"
                                      Glyph="&#xE8C6;"
                                      FontSize="14"
                                      VerticalAlignment="Center"
                                      Margin="2,0,4,0"
                                      Foreground="{ThemeResource SpanzipBrandBrush}" />

                            <TextBlock Grid.Column="1"
                                       x:Uid="ConfigPanel_SplitLabel"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource CardHeaderLabelStyle}" />

                            <ComboBox Grid.Column="2"
                                      x:Name="SplitCombo"
                                      HorizontalAlignment="Stretch"
                                      SelectedIndex="0"
                                      SelectionChanged="OnSplitChanged">
                                <ComboBoxItem x:Uid="ConfigPanel_SplitNone" Tag="0" />
                                <ComboBoxItem x:Uid="ConfigPanel_Split10Mb" Tag="10485760" />
                                <ComboBoxItem x:Uid="ConfigPanel_Split100Mb" Tag="104857600" />
                                <ComboBoxItem x:Uid="ConfigPanel_Split700Mb" Tag="734003200" />
                                <ComboBoxItem x:Uid="ConfigPanel_Split1Gb" Tag="1073741824" />
                                <ComboBoxItem x:Uid="ConfigPanel_Split47Gb" Tag="5046586573" />
                                <ComboBoxItem x:Uid="ConfigPanel_SplitCustom" Tag="-1" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- Card 3: Password + AES-256 -->
                    <Border Style="{StaticResource CompactCardStyle}"
                            PointerEntered="OnCardPointerEntered"
                            PointerExited="OnCardPointerExited">
                        <StackPanel Spacing="6">
                            <Grid ColumnSpacing="{StaticResource SpacingXSValue}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <FontIcon Grid.Column="0"
                                          FontFamily="{StaticResource SymbolThemeFontFamily}"
                                          Glyph="&#xE192;"
                                          FontSize="14"
                                          VerticalAlignment="Center"
                                          Margin="2,0,4,0"
                                          Foreground="{ThemeResource SpanzipBrandBrush}" />

                                <TextBlock Grid.Column="1"
                                           x:Uid="ConfigPanel_PasswordLabel"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource CardHeaderLabelStyle}" />

                                <PasswordBox Grid.Column="2"
                                             x:Name="PasswordInput"
                                             x:Uid="ConfigPanel_PasswordPlaceholder"
                                             PasswordChanged="OnPasswordChanged" />

                                <Button Grid.Column="3"
                                        x:Name="LockIndicator"
                                        Style="{StaticResource IconButtonStyle}"
                                        MinWidth="28"
                                        MinHeight="28"
                                        Padding="4"
                                        IsHitTestVisible="False"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}">
                                    <FontIcon x:Name="LockIcon"
                                              FontFamily="{StaticResource SymbolThemeFontFamily}"
                                              Glyph="&#xE785;"
                                              FontSize="{StaticResource IconSizeS}" />
                                </Button>

                                <ToggleButton Grid.Column="4"
                                              x:Name="RevealButton"
                                              x:Uid="ConfigPanel_PasswordRevealButton"
                                              Style="{StaticResource IconToggleButtonStyle}"
                                              MinWidth="28"
                                              MinHeight="28"
                                              Padding="4"
                                              Checked="OnRevealToggled"
                                              Unchecked="OnRevealToggled">
                                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}"
                                              Glyph="&#xE7B3;"
                                              FontSize="{StaticResource IconSizeS}" />
                                </ToggleButton>
                            </Grid>

                            <CheckBox x:Name="UseAes256Check"
                                      x:Uid="ConfigPanel_UseAes256"
                                      IsChecked="True"
                                      IsEnabled="False"
                                      MinHeight="0" />
                        </StackPanel>
                    </Border>

                    <!-- Bottom checkboxes — Tag carries the SettingsService
                         key so OnAdvancedToggle persists every change in the
                         same store the Settings dialog reads from.  Without
                         this sync the panel and dialog could drift. -->
                    <StackPanel Padding="4,4,0,0"
                                Spacing="2">
                        <StackPanel>
                            <CheckBox x:Name="ExcludeMetaCheck"
                                      x:Uid="ConfigPanel_ExcludeSystemMeta"
                                      MinHeight="0"
                                      Tag="Settings_ExcludeSystemMetadata"
                                      Checked="OnAdvancedToggle"
                                      Unchecked="OnAdvancedToggle" />
                            <TextBlock x:Uid="ConfigPanel_ExcludeSystemMetaSub"
                                       Style="{StaticResource CaptionTextStyle}"
                                       Margin="28,0,0,2"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        </StackPanel>

                        <CheckBox x:Name="VerifyCheck"
                                  x:Uid="ConfigPanel_VerifyAfterCompress"
                                  MinHeight="0"
                                  Tag="Settings_VerifyAfterCompress"
                                  Checked="OnAdvancedToggle"
                                  Unchecked="OnAdvancedToggle" />

                        <CheckBox x:Name="DeleteSourceCheck"
                                  x:Uid="ConfigPanel_DeleteSourceAfter"
                                  MinHeight="0"
                                  Tag="Settings_DeleteSourceAfterCompress"
                                  Checked="OnAdvancedToggle"
                                  Unchecked="OnAdvancedToggle" />

                        <CheckBox x:Name="SeparatelyCheck"
                                  x:Uid="ConfigPanel_CompressSeparately"
                                  MinHeight="0"
                                  Tag="Settings_CompressSeparately"
                                  Checked="OnAdvancedToggle"
                                  Unchecked="OnAdvancedToggle" />
                    </StackPanel>
                </StackPanel>
            </Expander>

        </StackPanel>
    </ScrollViewer>

</UserControl>
