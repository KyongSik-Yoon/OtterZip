<?xml version="1.0" encoding="utf-8"?>
<!--
  SpanZIP 타이포그래피 + 간격 + CornerRadius + Thickness 토큰
  참조: docs/02-design/design-tokens.md §2, §3, §4, §5

  폰트 전략: Segoe UI Variable 우선, 한글 폴백 Malgun Gothic.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================ -->
    <!--  Font Family                                                      -->
    <!-- ================================================================ -->
    <x:String x:Key="PrimaryFontFamily">Segoe UI Variable Display, Segoe UI Variable, Segoe UI, Malgun Gothic</x:String>
    <x:String x:Key="MonoFontFamily">Cascadia Code, Consolas, Courier New, Malgun Gothic</x:String>

    <!-- ================================================================ -->
    <!--  Typography Scale (Fluent 공식 + 커스텀)                          -->
    <!-- ================================================================ -->

    <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="LineHeight" Value="16" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="BodyStrongTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="BodyLargeTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFontFamily}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="LineHeight" Value="24" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="SubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFontFamily}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="28" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="TitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFontFamily}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="36" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="DisplayTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFontFamily}" />
        <Setter Property="FontSize" Value="68" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="92" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <!-- Monospace for filenames / code -->
    <Style x:Key="MonoSmallTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="CodeTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="PercentTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource PrimaryFontFamily}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ================================================================ -->
    <!--  Spacing (Thickness)                                              -->
    <!-- ================================================================ -->
    <Thickness x:Key="SpacingXXS">4</Thickness>
    <Thickness x:Key="SpacingXS">8</Thickness>
    <Thickness x:Key="SpacingS">12</Thickness>
    <Thickness x:Key="SpacingM">16</Thickness>
    <Thickness x:Key="SpacingL">24</Thickness>
    <Thickness x:Key="SpacingXL">32</Thickness>
    <Thickness x:Key="SpacingXXL">48</Thickness>
    <Thickness x:Key="SpacingXXXL">64</Thickness>

    <!-- 숫자만 필요한 경우 (예: Grid ColumnSpacing) -->
    <x:Double x:Key="SpacingXXSValue">4</x:Double>
    <x:Double x:Key="SpacingXSValue">8</x:Double>
    <x:Double x:Key="SpacingSValue">12</x:Double>
    <x:Double x:Key="SpacingMValue">16</x:Double>
    <x:Double x:Key="SpacingLValue">24</x:Double>
    <x:Double x:Key="SpacingXLValue">32</x:Double>
    <x:Double x:Key="SpacingXXLValue">48</x:Double>

    <!-- ================================================================ -->
    <!--  CornerRadius                                                     -->
    <!-- ================================================================ -->
    <CornerRadius x:Key="DialogCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="WindowCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="LogoCornerRadius">16</CornerRadius>
    <CornerRadius x:Key="CircleCornerRadius">9999</CornerRadius>

    <!-- ================================================================ -->
    <!--  Border Thickness                                                 -->
    <!-- ================================================================ -->
    <Thickness x:Key="BorderThin">1</Thickness>
    <Thickness x:Key="BorderMedium">2</Thickness>
    <Thickness x:Key="BorderThick">3</Thickness>

    <!-- ================================================================ -->
    <!--  Icon Size                                                        -->
    <!-- ================================================================ -->
    <x:Double x:Key="IconSizeXS">12</x:Double>
    <x:Double x:Key="IconSizeS">16</x:Double>
    <x:Double x:Key="IconSizeM">20</x:Double>
    <x:Double x:Key="IconSizeL">24</x:Double>
    <x:Double x:Key="IconSizeXL">48</x:Double>
    <x:Double x:Key="IconSizeXXL">72</x:Double>

    <!-- ================================================================ -->
    <!--  Animation Durations (milliseconds)                               -->
    <!-- ================================================================ -->
    <Duration x:Key="AnimationDurationFast">0:0:0.100</Duration>
    <Duration x:Key="AnimationDurationNormal">0:0:0.200</Duration>
    <Duration x:Key="AnimationDurationSlow">0:0:0.400</Duration>

</ResourceDictionary>
