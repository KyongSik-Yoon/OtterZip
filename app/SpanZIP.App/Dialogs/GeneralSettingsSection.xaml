<?xml version="1.0" encoding="utf-8"?>
<!--
  Settings → General tab. (Phase 6+ rev 3)
  7 items: Language, Theme, DefaultAction, ConfirmExitWhileBusy, ShowToast,
           QuitWhenLastClosed, "Set as default app" button.
  Form-style: 200px label column + stretching control column.
-->
<UserControl
    x:Class="SpanZIP.App.Dialogs.GeneralSettingsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
        <Grid ColumnSpacing="{StaticResource SpacingMValue}"
              RowSpacing="{StaticResource SpacingSValue}"
              Padding="{StaticResource SpacingL}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Language -->
            <TextBlock Grid.Row="0" Grid.Column="0"
                       x:Uid="Settings_LanguageLabel"
                       VerticalAlignment="Center"
                       Style="{StaticResource BodyTextStyle}" />
            <ComboBox Grid.Row="0" Grid.Column="1"
                      x:Name="LanguageCombo"
                      HorizontalAlignment="Stretch"
                      SelectionChanged="OnLanguageChanged">
                <ComboBoxItem x:Uid="Settings_LanguageSystem" Tag="" />
                <ComboBoxItem x:Uid="Settings_LanguageKo"     Tag="ko" />
                <ComboBoxItem x:Uid="Settings_LanguageEn"     Tag="en" />
            </ComboBox>

            <!-- Theme -->
            <TextBlock Grid.Row="1" Grid.Column="0"
                       x:Uid="Settings_ThemeSectionLabel"
                       VerticalAlignment="Top"
                       Margin="0,8,0,0"
                       Style="{StaticResource BodyTextStyle}" />
            <RadioButtons Grid.Row="1" Grid.Column="1"
                          x:Name="ThemeRadioButtons"
                          MaxColumns="1"
                          SelectionChanged="OnThemeSelectionChanged">
                <RadioButton x:Uid="Theme_System" Tag="0" />
                <RadioButton x:Uid="Theme_Light"  Tag="1" />
                <RadioButton x:Uid="Theme_Dark"   Tag="2" />
            </RadioButtons>

            <!-- Default action -->
            <TextBlock Grid.Row="2" Grid.Column="0"
                       x:Uid="Settings_DefaultActionLabel"
                       VerticalAlignment="Center"
                       Style="{StaticResource BodyTextStyle}" />
            <ComboBox Grid.Row="2" Grid.Column="1"
                      x:Name="DefaultActionCombo"
                      HorizontalAlignment="Stretch"
                      SelectionChanged="OnDefaultActionChanged">
                <ComboBoxItem x:Uid="Settings_DefaultActionAuto"     Tag="auto" />
                <ComboBoxItem x:Uid="Settings_DefaultActionCompress" Tag="compress" />
                <ComboBoxItem x:Uid="Settings_DefaultActionExtract"  Tag="extract" />
            </ComboBox>

            <!-- Single-line toggles span both columns visually. -->
            <CheckBox Grid.Row="3" Grid.ColumnSpan="2"
                      x:Name="ConfirmExitCheck"
                      x:Uid="Settings_ConfirmExitWhileBusy"
                      MinHeight="0"
                      Margin="0,8,0,0"
                      Checked="OnToggle"
                      Unchecked="OnToggle"
                      Tag="Settings_ConfirmExitWhileBusy" />

            <CheckBox Grid.Row="4" Grid.ColumnSpan="2"
                      x:Name="ShowToastCheck"
                      x:Uid="Settings_ShowToast"
                      MinHeight="0"
                      Checked="OnToggle"
                      Unchecked="OnToggle"
                      Tag="Settings_ShowToast" />

            <!-- "Quit when all windows closed" 옵션은 트레이 시스템이
                 있어야 의미가 있음. SpanZIP은 셸 확장 + 일회성 윈도우
                 패턴이라 트레이 거주 자체를 안 함 — 옵션 제거. -->

            <!-- Set as default — Windows ms-settings deep link. -->
            <Button Grid.Row="5" Grid.ColumnSpan="2"
                    x:Uid="Settings_OpenDefaultApps"
                    Margin="0,16,0,0"
                    HorizontalAlignment="Left"
                    Click="OnOpenDefaultApps" />
        </Grid>
    </ScrollViewer>
</UserControl>
